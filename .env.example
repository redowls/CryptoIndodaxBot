# --- Indodax TAPI v2 -------------------------------------------------------
# Generate at https://indodax.com → Settings → API. The key must be a v2 key;
# v1 (https://indodax.com/tapi) rejects v2 keys with invalid_version_key.
# Spot-trading permission REQUIRES the server IP to be whitelisted on the key.
INDODAX_API_KEY=
INDODAX_API_SECRET=

# --- Telegram --------------------------------------------------------------
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# --- Trading ---------------------------------------------------------------
# ⚠️ Indodax has NO paper/sandbox endpoint. Setting this true spends real IDR.
# Preview safely with: python -m cryptoindodax.trader --dry-run
TRADING_ENABLED=false
